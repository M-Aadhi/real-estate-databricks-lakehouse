# Copy to .env for local overrides. Never commit .env.
# Pipeline environment: local (default) or databricks
LAKEHOUSE_ENV=local
# Optional Spark tuning for local runs
SPARK_MASTER=local[2]
SPARK_SHUFFLE_PARTITIONS=4

# Only needed if you deploy with the Databricks CLI / SDK from your machine.
# Prefer `databricks auth login` (OAuth) over tokens. Do not commit real values.
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=<never-commit-a-real-token>
